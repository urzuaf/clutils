      "expected_formal": "5 de enero de 2026",
      "expected_full": "Lunes, 5 de enero de 2026",
      "description": "Dia con un solo digito 5 de Enero 2026"
    },
    {
      "year": 2026,
      "month": 11,
      "day": 1,
      "expected_numeric": "01/11/2026",
      "expected_numeric_hyphen": "01-11-2026",

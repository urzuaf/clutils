  "iva_calculation": [
    {
      "input_amount": 100,
      "is_bruto": false,
      "expected_neto": 100,
      "expected_iva": 19,
      "expected_bruto": 119,
      "description": "Neto base 100"
    },
    {
      "input_amount": 1000,
      "is_bruto": false,
      "expected_neto": 1000,
      "expected_iva": 190,
      "expected_bruto": 1190,
      "description": "Neto base 1.000"
    },
    {
      "input_amount": 1005,
      "is_bruto": false,
      "expected_neto": 1005,
      "expected_iva": 191,
      "expected_bruto": 1196,
      "description": "Neto 1.005 con redondeo de IVA hacia arriba (190.95 -> 191)"
    },
    {
      "input_amount": 0,
      "is_bruto": false,
      "expected_neto": 0,
      "expected_iva": 0,
      "expected_bruto": 0,
      "description": "Neto cero"
    },
    {
      "input_amount": 100000,
      "is_bruto": false,
      "expected_neto": 100000,
      "expected_iva": 19000,
      "expected_bruto": 119000,
      "description": "Neto 100.000"
    },
    {
      "input_amount": 840,
      "is_bruto": false,
      "expected_neto": 840,
      "expected_iva": 160,
      "expected_bruto": 1000,
      "description": "Neto 840 con IVA redondeado a 160 dando bruto 1.000"
    },
    {
      "input_amount": 1000,
      "is_bruto": true,
      "expected_neto": 840,
      "expected_iva": 160,
      "expected_bruto": 1000,
      "description": "Bruto 1.000 desglosado con regla SII (Neto 840, IVA 160)"
    },
    {
      "input_amount": 119,
      "is_bruto": true,
      "expected_neto": 100,
      "expected_iva": 19,
      "expected_bruto": 119,
      "description": "Bruto 119 exacto"
    },
    {
      "input_amount": 1190,
      "is_bruto": true,
      "expected_neto": 1000,
      "expected_iva": 190,
      "expected_bruto": 1190,
      "description": "Bruto 1.190 exacto"
    },
    {
      "input_amount": 1,
      "is_bruto": true,
      "expected_neto": 1,
      "expected_iva": 0,
      "expected_bruto": 1,
      "description": "Bruto 1 peso minimo"
    },
    {
      "input_amount": 0,
      "is_bruto": true,
      "expected_neto": 0,
      "expected_iva": 0,
      "expected_bruto": 0,
      "description": "Bruto cero"
    },
    {
      "input_amount": 1196,
      "is_bruto": true,
      "expected_neto": 1005,
      "expected_iva": 191,
      "expected_bruto": 1196,
      "description": "Bruto 1.196 desglosado a Neto 1.005 e IVA 191"
    },
    {
      "input_amount": -50,
      "is_bruto": false,
      "expected_neto": -50,
      "expected_iva": -10,
      "expected_bruto": -60,
      "description": "Neto negativo con tie-break de redondeo a -10 (-50 * 0.19 = -9.5)"
    },
    {
      "input_amount": -60,
      "is_bruto": true,
      "expected_neto": -50,
      "expected_iva": -10,
      "expected_bruto": -60,
      "description": "Bruto negativo -60 desglosado simetricamente a Neto -50 e IVA -10"
    }
  ],

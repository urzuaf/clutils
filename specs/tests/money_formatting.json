{
  "description": "Vectores de prueba canonicos compartidos para operaciones monetarias chilenas (CLP, UF, UTM, IVA, toWords)",
  "clp_formatting": [
    {
      "amount": 0,
      "expected_default": "$0",
      "expected_space": "$ 0",
      "expected_symbol_clp": "CLP 0",
      "expected_no_symbol": "0",
      "description": "Monto cero"
    },
    {
      "amount": 100,
      "expected_default": "$100",
      "expected_space": "$ 100",
      "expected_symbol_clp": "CLP 100",
      "expected_no_symbol": "100",
      "description": "Monto de tres digitos sin separador de miles"
    },
    {
      "amount": 1500,
      "expected_default": "$1.500",
      "expected_space": "$ 1.500",
      "expected_symbol_clp": "CLP 1.500",
      "expected_no_symbol": "1.500",
      "description": "Monto de cuatro digitos con un punto de miles"
    },
    {
      "amount": 1500000,
      "expected_default": "$1.500.000",
      "expected_space": "$ 1.500.000",
      "expected_symbol_clp": "CLP 1.500.000",
      "expected_no_symbol": "1.500.000",
      "description": "Monto en millones con dos puntos de miles"
    },
    {
      "amount": 1234567890,
      "expected_default": "$1.234.567.890",
      "expected_space": "$ 1.234.567.890",
      "expected_symbol_clp": "CLP 1.234.567.890",
      "expected_no_symbol": "1.234.567.890",
      "description": "Monto grande de diez digitos"
    },
    {
      "amount": -2500,
      "expected_default": "-$2.500",
      "expected_space": "-$ 2.500",
      "expected_symbol_clp": "-CLP 2.500",
      "expected_no_symbol": "-2.500",
      "expected_parentheses": "($2.500)",
      "description": "Monto negativo con formato estandar y contable entre parentesis"
    },
    {
      "amount": -50000,
      "expected_default": "-$50.000",
      "expected_space": "-$ 50.000",
      "expected_symbol_clp": "-CLP 50.000",
      "expected_no_symbol": "-50.000",
      "expected_parentheses": "($50.000)",
      "description": "Monto negativo en decenas de miles"
    }
  ],
  "clp_parsing": [
    {
      "input": "$1.500.000",
      "expected": 1500000,
      "valid": true,
      "description": "CLP estandar con signo peso y puntos"
    },
    {
      "input": "$ 1.500.000",
      "expected": 1500000,
      "valid": true,
      "description": "CLP con espacio tras signo de peso"
    },
    {
      "input": "1.500.000 CLP",
      "expected": 1500000,
      "valid": true,
      "description": "CLP con sufijo CLP"
    },
    {
      "input": "CLP 1.500.000",
      "expected": 1500000,
      "valid": true,
      "description": "CLP con prefijo CLP"
    },
    {
      "input": "$1500000",
      "expected": 1500000,
      "valid": true,
      "description": "CLP sin puntos de miles"
    },
    {
      "input": "1500000",
      "expected": 1500000,
      "valid": true,
      "description": "Numero plano sin formato"
    },
    {
      "input": "-$2.500",
      "expected": -2500,
      "valid": true,
      "description": "CLP negativo con signo menos antes de pesos"
    },
    {
      "input": "$-2.500",
      "expected": -2500,
      "valid": true,
      "description": "CLP negativo con signo menos tras pesos"
    },
    {
      "input": "($2.500)",
      "expected": -2500,
      "valid": true,
      "description": "CLP negativo en formato contable con parentesis"
    },
    {
      "input": "-2500",
      "expected": -2500,
      "valid": true,
      "description": "Numero plano negativo"
    },
    {
      "input": "(2500)",
      "expected": -2500,
      "valid": true,
      "description": "Numero entre parentesis sin signo peso"
    },
    {
      "input": "$0",
      "expected": 0,
      "valid": true,
      "description": "Cero con signo peso"
    },
    {
      "input": "0",
      "expected": 0,
      "valid": true,
      "description": "Cero plano"
    },
    {
      "input": "   $ 990   ",
      "expected": 990,
      "valid": true,
      "description": "CLP con espacios al inicio y final"
    },
    {
      "input": "abc",
      "expected": 0,
      "valid": false,
      "description": "Texto sin digitos"
    },
    {
      "input": "",
      "expected": 0,
      "valid": false,
      "description": "String vacio"
    },
    {
      "input": "   ",
      "expected": 0,
      "valid": false,
      "description": "Espacios en blanco"
    },
    {
      "input": "$",
      "expected": 0,
      "valid": false,
      "description": "Solo signo peso sin digitos"
    },
    {
      "input": "--100",
      "expected": 0,
      "valid": false,
      "description": "Doble signo menos invalido"
    },
    {
      "input": "12(34)5",
      "expected": 0,
      "valid": false,
      "description": "Parentesis dentro de los digitos"
    },
    {
      "input": ")100(",
      "expected": 0,
      "valid": false,
      "description": "Parentesis invertidos"
    },
    {
      "input": "(100)5",
      "expected": 0,
      "valid": false,
      "description": "Digito posterior a parentesis de cierre"
    },
    {
      "input": "1-00",
      "expected": 0,
      "valid": false,
      "description": "Signo menos en medio de digitos"
    },
    {
      "input": "100-",
      "expected": 0,
      "valid": false,
      "description": "Signo menos posterior a los digitos"
    },
    {
      "input": "-CLP 2.500",
      "expected": -2500,
      "valid": true,
      "description": "Round-trip de FormatCLP negativo con prefijo CLP"
    },
    {
      "input": "(CLP 2.500)",
      "expected": -2500,
      "valid": true,
      "description": "CLP negativo contable con prefijo CLP dentro de parentesis"
    },
    {
      "input": "($2.500 CLP)",
      "expected": -2500,
      "valid": true,
      "description": "CLP negativo contable con sufijo CLP dentro de parentesis"
    },
    {
      "input": "1.5",
      "expected": 0,
      "valid": false,
      "description": "Separador de miles mal ubicado (posible decimal US) rechazado"
    },
    {
      "input": "$10.50",
      "expected": 0,
      "valid": false,
      "description": "Formato decimal estadounidense rechazado en CLP"
    },
    {
      "input": "1..000",
      "expected": 0,
      "valid": false,
      "description": "Puntos consecutivos invalidos"
    },
    {
      "input": "10$00",
      "expected": 0,
      "valid": false,
      "description": "Simbolo peso en medio de los digitos"
    }
  ],
  "uf_formatting": [
    {
      "amount": 38450.25,
      "decimals": 2,
      "expected_default": "UF 38.450,25",
      "expected_no_symbol": "38.450,25",
      "description": "UF estandar con 2 decimales"
    },
    {
      "amount": 1.5,
      "decimals": 2,
      "expected_default": "UF 1,50",
      "expected_no_symbol": "1,50",
      "description": "UF con relleno de cero en decimales"
    },
    {
      "amount": 0,
      "decimals": 2,
      "expected_default": "UF 0,00",
      "expected_no_symbol": "0,00",
      "description": "UF cero con 2 decimales"
    },
    {
      "amount": 1200,
      "decimals": 2,
      "expected_default": "UF 1.200,00",
      "expected_no_symbol": "1.200,00",
      "description": "UF entero formateado con decimales en cero"
    },
    {
      "amount": 38450.2548,
      "decimals": 4,
      "expected_default": "UF 38.450,2548",
      "expected_no_symbol": "38.450,2548",
      "description": "UF financiera/seguros con 4 decimales"
    },
    {
      "amount": 38450.256,
      "decimals": 2,
      "expected_default": "UF 38.450,26",
      "expected_no_symbol": "38.450,26",
      "description": "UF con redondeo al decimal mas cercano"
    },
    {
      "amount": -15.5,
      "decimals": 2,
      "expected_default": "UF -15,50",
      "expected_no_symbol": "-15,50",
      "description": "UF negativa"
    },
    {
      "amount": -0.001,
      "decimals": 2,
      "expected_default": "UF 0,00",
      "expected_no_symbol": "0,00",
      "description": "UF negativa pequena que redondea a cero no debe mostrar -0,00"
    },
    {
      "amount": 1.125,
      "decimals": 2,
      "expected_default": "UF 1,13",
      "expected_no_symbol": "1,13",
      "description": "UF con mitad exacta binaria usa redondeo aritmetico half-away-from-zero en Go y TS"
    }
  ],
